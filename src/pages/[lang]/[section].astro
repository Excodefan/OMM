---
import Base from '../../layouts/Base.astro';
import PostCards from '../../components/PostCards.astro';
import { getEntry, render } from 'astro:content';
import { getPosts } from '../../lib/posts';
import { getProjects } from '../../lib/pages';
import { languages, words, type Lang } from '../../lib/i18n';
export function getStaticPaths() { return languages.flatMap(lang => ['about','writing','experience','projects','contact'].map(section => ({params:{lang,section}}))); }
const lang = Astro.params.lang as Lang;
const section = Astro.params.section as 'about'|'writing'|'experience'|'projects'|'contact';
const t = words[lang];
const defaultTitles = {about:t.aboutTitle, writing:t.writing, experience:t.experience, projects:t.projectsTitle, contact:t.contact};
const defaultIntros = {about:t.aboutText, writing:t.writingIntro, experience:t.experienceIntro, projects:t.projectIntro, contact:t.contactText};
const navTitles = {about:t.about, writing:t.writing, experience:t.experience, projects:t.projectsTitle, contact:t.contact};

// Textele paginilor se editează în Keystatic → Pages.
const page = ['about','experience','contact'].includes(section) ? await getEntry('pages', `${section}-${lang}`) : undefined;
const Body = page ? (await render(page)).Content : null;
const projects = section === 'projects' ? await getProjects(lang) : null;
const posts = section === 'writing' ? await getPosts(lang) : [];
const heading = page?.data.title || defaultTitles[section];
const intro = projects?.intro || page?.data.intro || defaultIntros[section];
---
<Base lang={lang} title={navTitles[section]}>
<div class="page-head"><div class="eyebrow">OM. / {navTitles[section]}</div><h1>{heading}</h1><p>{intro}</p></div>
{section === 'writing' && <section class="section">{posts.length ? <PostCards posts={posts} lang={lang}/> : <p>{t.noPost}</p>}</section>}
{Body && <div class="prose"><Body />{section === 'contact' && page?.data.email && <p><a href={`mailto:${page.data.email}`}>{page.data.email}</a></p>}</div>}
{projects && <div class="cards">{projects.items.map((p,i) => <div class="card project-card"><div class="project-icon">{['◇','▤','◈'][i%3]}</div><h3>{p.name}</h3><p>{p.description}</p>{p.status && <span class="chip">{p.status}</span>}</div>)}</div>}
</Base>
