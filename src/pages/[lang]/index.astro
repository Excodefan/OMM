---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { words, localPath, languages, type Lang } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params:{lang} })); }
const lang = Astro.params.lang as Lang; const t = words[lang];
const h = (await getEntry('home', `home-${lang}`))!.data;
const paras = (s: string) => s.split(/\n\s*\n/).map(x => x.trim()).filter(Boolean);
---
<Base lang={lang}>
<section class="hero"><div><div class="eyebrow">{t.kicker}</div><h1>{h.heroTitle}</h1><p>{h.heroText}</p><div class="actions"><a class="button primary" href={localPath(lang,'experience')}>{h.heroPrimary} ↗</a><a class="button" href={localPath(lang,'about')}>{h.heroSecondary}</a></div></div><div class="hero-art" role="img" aria-label="Abstract layered landscape illustration"><div class="sun"></div><div class="orbit"></div><div class="node"></div></div></section>

<section class="section home-block"><h2>{h.aboutTitle}</h2><div class="home-body">{paras(h.aboutText).map(p => <p>{p}</p>)}<a class="button" href={localPath(lang,'about')}>{h.aboutCta} ↗</a></div></section>

<section class="section home-block"><h2>{h.writingTitle}</h2><div class="home-body">{paras(h.writingText).map(p => <p>{p}</p>)}<a class="button" href={localPath(lang,'writing')}>{h.writingCta} ↗</a></div></section>

<section class="section home-block"><h2>{h.projectsTitle}</h2><div class="home-body">{paras(h.projectsText).map(p => <p>{p}</p>)}{h.projectsNote && <span class="chip">{h.projectsNote}</span>}</div></section>

<section class="section"><div class="story-banner"><div><h2>{h.contactTitle}</h2><p>{h.contactText}</p></div><a href={localPath(lang,'contact')} class="button primary">{h.contactCta} ↗</a></div></section>
</Base>
