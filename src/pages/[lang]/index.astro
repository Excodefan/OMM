---
import Base from '../../layouts/Base.astro';
import PostCards from '../../components/PostCards.astro';
import { getPosts } from '../../lib/posts';
import { words, localPath, languages, type Lang } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params:{lang} })); }
const lang = Astro.params.lang as Lang; const t = words[lang];
const posts = (await getPosts(lang)).slice(0,3);
const projectNames = lang === 'en' ? ['AI Agents Lab','Report Assistant','Personal Knowledge Base'] : ['Laborator de agenți AI','Asistent pentru rapoarte','Bază personală de cunoștințe'];
const projectDescriptions = lang === 'en' ? ['A sandbox for exploring agent workflows and local language models.','A concept for extracting, comparing and reviewing project documents.','A possible searchable, local-first knowledge system.'] : ['Un spațiu pentru explorarea agenților și a modelelor lingvistice locale.','Un concept pentru extragerea, compararea și verificarea documentelor.','Un posibil sistem de cunoștințe personal, căutabil și local.'];
---
<Base lang={lang}>
<section class="hero"><div><div class="eyebrow">{t.kicker}</div><h1>{t.hero}</h1><p>{t.intro}</p><div class="actions"><a class="button primary" href={localPath(lang,'writing')}>{t.read} ↗</a><a class="button" href={localPath(lang,'projects')}>{t.projects}</a></div></div><div class="hero-art" role="img" aria-label="Abstract layered landscape illustration"><div class="sun"></div><div class="orbit"></div><div class="node"></div></div></section>
<div class="focus"><div class="focus-label">{t.focus}</div><div class="focus-items">{t.areas.map(area=><span>✦ {area}</span>)}</div></div>
<section class="section"><div class="section-head"><h2>{t.recent}</h2><a href={localPath(lang,'writing')}>{t.all} ↗</a></div>{posts.length ? <PostCards posts={posts} lang={lang}/> : <p>{t.noPost}</p>}</section>
<section class="section"><div class="section-head"><h2>{t.lab}</h2><a href={localPath(lang,'projects')}>{t.projects} ↗</a></div><div class="cards">{projectNames.map((name,i)=><a class="card project-card" href={localPath(lang,'projects')}><div class="project-icon">{['◇','▤','◈'][i]}</div><h3>{name}</h3><p>{projectDescriptions[i]}</p><span class="chip">{t.demo}</span></a>)}</div></section>
<section class="section"><div class="story-banner"><div><div class="eyebrow">CAREER STORIES</div><h2>{t.journey}</h2><p>{t.journeyDesc}</p></div><a href={localPath(lang,'experience')} class="button primary">{t.careerButton} ↗</a></div></section>
</Base>
